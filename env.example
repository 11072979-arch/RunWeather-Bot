# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Comma-separated Telegram chat IDs; send /start to the bot first
TELEGRAM_CHAT_IDS=replace_with_your_chat_id

# Default location: Kropyvnytskyi, Ukraine
LATITUDE=48.5079
LONGITUDE=32.2623
LOCATION_NAME=Кропивницький

# Daily schedule timezone
TIMEZONE=Europe/Kyiv
